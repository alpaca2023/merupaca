# メルパカ 環境変数テンプレート
# このファイルをコピーして .env.local を作り、各キーを設定してください。
# .env.local は git にコミットされません（.gitignore で除外済み）。

# ===== Anthropic Claude API（Step 1 で必須） =====
ANTHROPIC_API_KEY=

# ===== Firebase Client SDK（Step 2 で必須） =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=merupaca
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin SDK（Step 3 の Webhook で必須） =====
FIREBASE_ADMIN_PROJECT_ID=merupaca
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ===== Stripe（Step 3 で必須） =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ===== その他 =====
NEXT_PUBLIC_BASE_URL=http://localhost:3000
