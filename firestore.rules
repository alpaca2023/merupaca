rules_version = '2';

// メルパカ Firestore セキュリティルール
//
// 設計方針:
//   - users/{uid} ドキュメントは本人のみ R/W
//   - 課金関連フィールド（plan / stripeCustomerId / stripeSubscriptionId / subscriptionStatus / lastWebhookEventId）は
//     クライアントから変更不可。Admin SDK（Stripe Webhook）経由のみ更新可能。
//   - usage は本人が read 可能、write は Admin SDK のみ
//   - styleSamples は後続 PR で追加する
//   - それ以外のパスは明示的に拒否（ホワイトリスト方式）
//
// レビュー指摘 H-1 反映（2026-05-31）:
//   悪意あるユーザーが devtools から plan:"paid" を書き込めない構造にする。

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== users/{uid} =====
    match /users/{userId} {
      // 読み取り：本人のみ
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      // 新規作成：本人のみ。課金フィールドは free 固定 / 未設定
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.plan == "free"
                    && !("stripeCustomerId" in request.resource.data)
                    && !("stripeSubscriptionId" in request.resource.data)
                    && !("subscriptionStatus" in request.resource.data)
                    && !("lastWebhookEventId" in request.resource.data);

      // 更新：本人のみ。課金フィールドは元の値と同じであること
      // （plan / stripeCustomerId / stripeSubscriptionId / subscriptionStatus / lastWebhookEventId は Admin SDK = Stripe Webhook 経由のみ更新可）
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.plan == resource.data.plan
                    && request.resource.data.get("stripeCustomerId", null)
                       == resource.data.get("stripeCustomerId", null)
                    && request.resource.data.get("stripeSubscriptionId", null)
                       == resource.data.get("stripeSubscriptionId", null)
                    && request.resource.data.get("subscriptionStatus", null)
                       == resource.data.get("subscriptionStatus", null)
                    && request.resource.data.get("lastWebhookEventId", null)
                       == resource.data.get("lastWebhookEventId", null);

      // 削除：本人のみ（設定リセット用）
      allow delete: if request.auth != null
                    && request.auth.uid == userId;

      match /usage/{dateKey} {
        allow read: if request.auth != null
                    && request.auth.uid == userId
                    && dateKey.matches("^\\d{4}-\\d{2}-\\d{2}$");
        allow write: if false;
      }

      // Step 5 で追加予定: users/{uid}/styleSamples/{autoId}
      // → 該当 PR で本ファイルに rule を追記する
    }

    // ===== それ以外は全拒否（明示） =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
